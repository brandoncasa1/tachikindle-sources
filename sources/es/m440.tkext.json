{
  "$schema": "tachikindle-extension-1.0",
  "id": "es.m440",
  "name": "M440",
  "lang": "es",
  "base_url": "https://m440.in",
  "version_code": 1,
  "source_script": "sources/es/m440",
  "content_warning": "MIXED",
  "client": {
    "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
  },
  "endpoints": {
    "popular": { "method": "GET", "path": "/" },
    "latest": { "method": "GET", "path": "/" },
    "search": { "method": "GET", "path": "/" },
    "manga_details": { "method": "GET", "path": "{manga_url}" },
    "chapter_list": { "method": "GET", "path": "{manga_url}" },
    "page_list": { "method": "GET", "path": "{chapter_url}" }
  },
  "selectors": {
    "manga_list_item": null,
    "manga_title": null,
    "manga_url": null,
    "details_title": null,
    "chapter_item": null,
    "chapter_title": null,
    "chapter_url": null,
    "page_image": null
  },
  "pagination": { "strategy": "fixed_page_size", "page_size": 20 },
  "update_strategy": "ALWAYS_UPDATE"
}
