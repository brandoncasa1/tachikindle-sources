{
  "$schema": "tachikindle-extension-1.0",
  "id": "es.mangadex",
  "name": "MangaDex (ES)",
  "lang": "es",
  "base_url": "https://api.mangadex.org",
  "version_code": 1,
  "source_script": "sources/es/mangadex_es",
  "content_warning": "SAFE",
  "client": {
    "user_agent": "TachiKindle/1.0 (KOReader) MangaDexES/1.0",
    "extra_headers": { "Accept": "application/json" }
  },
  "endpoints": {
    "popular": { "method": "GET", "path": "/manga" },
    "latest": { "method": "GET", "path": "/manga" },
    "search": { "method": "GET", "path": "/manga" },
    "manga_details": { "method": "GET", "path": "/manga/{manga_url}" },
    "chapter_list": { "method": "GET", "path": "/manga/{manga_url}/feed" },
    "page_list": { "method": "GET", "path": "/at-home/server/{chapter_url}" }
  },
  "selectors": {
    "manga_list_item": null,
    "manga_title": null,
    "manga_url": null,
    "details_title": null,
    "chapter_item": null,
    "chapter_title": null,
    "chapter_url": null,
    "page_image": null
  },
  "pagination": { "strategy": "fixed_page_size", "page_size": 20 },
  "update_strategy": "ALWAYS_UPDATE"
}
